eval_legacy { setEcoMode -honorDontUse true }
eval_legacy { setEcoMode -honorFixedNetWire true }
eval_legacy { setEcoMode -honorFixedStatus true }
eval_legacy { setEcoMode -legalizeDuringCommit true }
eval_legacy { setEcoMode -prefixName ECO }
eval_legacy { setEcoMode -refinePlace true }
eval_legacy { setEcoMode -updateTiming true }
eval_legacy { setEcoMode -batchMode false }
eval_legacy { setEcoMode -honorDontTouch true }
eval_legacy { setEcoMode -honorDontUse true }
eval_legacy { setEcoMode -honorFixedStatus true }
eval_legacy { setEcoMode -honorFixedNetWire true }
eval_legacy { setEcoMode -legalizeDuringCommit true }
