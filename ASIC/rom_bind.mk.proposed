#-----------------------------------------------------------------------------
# ASIC/rom_bind.mk.proposed - PROJECT-SIDE WIRING FOR THE ROM BINDING GATE
#
# NOT INCLUDED BY ANYTHING. The `.proposed' suffix keeps make from picking it
# up. It is here because the ROM table it extends lives in ASIC/rom_gate.mk,
# which another agent owns right now, and editing that file would collide.
#
# TO LAND IT, either:
#   (a) append the ROM_BIND_* block below to ASIC/rom_gate.mk (where ROMS,
#       ROM_INST_eth and ROM_INST_cc are already declared), and add the
#       `include' line to ASIC/eth-chiplet/Makefile after mk/flow.mk; or
#   (b) rename this file to ASIC/rom_bind.mk and add one `include' line to
#       ASIC/common.mk next to the existing `include .../rom_gate.mk'.
#
# (b) keeps it out of the file under contention. (a) puts the table where the
# other ROM values already are. Either is fine; nothing here depends on which.
#
# WHAT THIS GATES, AND WHY IT IS NEW
# ----------------------------------
# ASIC/rom_gate.mk proves what is IN the ROM: the compiler's content views, the
# CDL, the streamed GDS and the firmware all agree. mk/gls.mk proves the macro
# returns those words when its own pins are driven. Neither has any opinion
# about whether the routed netlist INSTANTIATES the macro or what it wires to
# the address pins -- and no other tool in the flow does either: P&R places a
# black box, LEC compares a leaf against a leaf, DRC and LVS check the macro's
# geometry against its own netlist.
#
# A netlist whose ROM address bus is REVERSED passes every one of those and
# boots the right words in the wrong order.
#
# MEASURED ON THIS DESIGN, 2026-08-18: both ROMs are correctly bound in both
# ASIC/eth-chiplet/build/fp1505/ and build/full-20260814/. The values below are
# the ones that were measured, so this gate starts from a known-good state and
# any future change to it is a regression rather than a discovery.
#-----------------------------------------------------------------------------

# --- in ASIC/eth-chiplet/Makefile, after `include $(ASIC_FLOW_DIR)/mk/flow.mk':
#
#     include $(ASIC_FLOW_DIR)/mk/rom_bind.mk
#
# --- and the table (ROMS is already `eth cc' from ASIC/rom_gate.mk):

ROM_BIND_TOP := $(BLOCK)

# The macro MODULE name as place-and-route instantiates it. Same value as
# ROM_INST_<r> in ASIC/rom_gate.mk, named separately so the two gates cannot
# silently drift into checking different macros.
ROM_BIND_MACRO_eth   := eth_rom_via
ROM_BIND_MACRO_V_eth := $(ROMLIBS_DIR)/eth_rom/eth_rom_via.v
ROM_BIND_MACRO_cc    := rom_via
ROM_BIND_MACRO_V_cc  := $(ROMLIBS_DIR)/cc_rom/rom_via.v

# THE EXPECTATION. Both boot ROMs are 512 x 32, so the macro takes a 9-bit WORD
# address, and the AHB region decode presents it as HADDR[10:2] -- bits 1:0 are
# the byte offset within a word and never reach the macro. MSB first, which is
# how both instances are concatenated today.
#
# This is the value that must never be inferred. Deriving `9 bits' from the
# macro would accept any 9 correctly-named nets in any order, which is exactly
# the defect the gate exists to catch.
ROM_BIND_ADDR_SLICE_eth := 10:2
ROM_BIND_ADDR_SLICE_cc  := 10:2

# Regexes, not literals, because place-and-route prefixes buffered nets
# (FE_OFN4442_...) and the compute-side instance carries a `u_chip_core_'
# hierarchy prefix. Anchored at the end so `..._haddr' cannot match `..._haddr_x'
# of some other bus.
ROM_BIND_ADDR_BUS_eth := i_bootrom_0_haddr$$
ROM_BIND_DATA_NET_eth := i_bootrom_0_hrdata$$
ROM_BIND_ADDR_BUS_cc  := i_bootrom_0_haddr$$
ROM_BIND_DATA_NET_cc  := i_bootrom_0_hrdata$$

ROM_BIND_COUNT_eth := 1
ROM_BIND_COUNT_cc  := 1

# EMA is the read-margin setting and is 3'b010 on both instances in both builds.
# It is asserted here rather than merely printed because the value has now been
# measured twice on two independently routed netlists; writing it down is what
# turns "nobody looked" into "this changed".
#
# TEN/BEN/TCEN are printed and NOT asserted: they are test-mode pins whose
# correct values are a DFT decision this session did not verify against the
# macro datasheet. Printing them makes a change visible; asserting a value
# nobody has confirmed would be inventing an expectation.
ROM_BIND_ARGS_eth := --report-port EMA --report-port TEN --report-port BEN \
                     --report-port TCEN --report-port PGEN --report-port KEN \
                     --expect-tie EMA=010
ROM_BIND_ARGS_cc  := --report-port EMA --report-port TEN --report-port BEN \
                     --report-port TCEN --report-port PGEN --report-port KEN \
                     --expect-tie EMA=010

#-----------------------------------------------------------------------------
# HOW TO RUN IT
#
#   make -C ASIC/eth-chiplet rom-bind-gate RUN_TAG=fp1505
#
# ROM_BIND_NETLIST defaults to nothing on purpose, so add ONE of:
#
#   ROM_BIND_NETLIST ?= $(OUT_DIR)/$(BLOCK)_pnr.v
#
# to default it to the current run's routed netlist, or keep passing it
# explicitly. Defaulting it is safe here only because mk/rom_bind.mk FAILS on a
# missing or empty file rather than skipping -- a gate that silently passes when
# its input is absent is the failure mode the whole ROM chain is built against.
#
# Roughly 20 s for both ROMs on the 42 MB netlist. No licence, no tool.
#-----------------------------------------------------------------------------
