set phys_lib /research/AAA/phys_ip_library

set base_path $::env(TSMC_65_HOME)/CMOS/LP/stclib/9-track/tcbn65lp-set/tcbn65lp_220a_FE/TSMCHOME/digital/
set tech_path ${phys_lib}/arm/tsmc/cln65lp/arm_tech/r2p0
set rf_32k_path /research/precompiled_mems/TSMC65/rf_32k
set rf_16k_path /research/precompiled_mems/TSMC65/rf_16k/ 
set rf_08k_path /research/precompiled_mems/TSMC65/rf_08k/ 
set rf_01k_path /research/precompiled_mems/TSMC65/rf_01k/
set flash_cache_data_path /research/precompiled_mems/TSMC65/flash_cache_data/
set flash_cache_tag_path /research/precompiled_mems/TSMC65/flash_cache_tag/
# DESIGN_HOME, with the historical name as fallback -- see config.tcl.
#
# THIS FILE REPEATS THE FALLBACK INSTEAD OF USING config.tcl's $::design_home,
# and that is deliberate. It is loaded by `read_mmmc`, not by `source`, so
# whether config.tcl's globals are in scope here is a property of the Cadence
# command rather than of this repo -- and getting it wrong aborts every P&R
# stage at setup. $::env is visible in every Tcl context there is, so this form
# is safe under either answer. Collapse it onto $::design_home only after
# watching a real `make pnr_place` read this file.
set design_home [expr {[info exists ::env(DESIGN_HOME)]
                       ? $::env(DESIGN_HOME)
                       : $::env(NANOSOC_ETH_CHIPLET_HOME)}]

# ── THE BOOT ROMs COME FROM THIS RUN, NOT THE SHARED DROP ──────────────────
#
# SAME PRECEDENCE AS scripts/config.tcl:156-162 AND
# ASIC/eth-chiplet/config/design_config.tcl:101-107, AND IT HAS TO BE, because
# those two decide what SYNTHESIS reads and this file decides what P&R reads.
# ASIC/rom_build.mk compiles both mask-programmed macros per run into
# <run>/romlibs and ASIC/eth-chiplet/design.mk:692 exports ROMLIBS_DIR naming
# it; config.tcl was given that override and this file was NOT, so every P&R
# stage timed the ROMs against $design_home/ASIC/romlibs while synthesis read
# the run's own build. That divergence is exactly what pinning the ROMs per run
# was introduced to prevent -- these macros have shipped the wrong bits twice.
#
# AND IT WAS A HARD STOP, NOT ONLY AN INCONSISTENCY (measured 2026-08-30, rc5).
# ASIC/romlibs is GITIGNORED. It exists in the checkout it was compiled in and
# nowhere else: not in a git worktree, not in a fresh clone, not in CI. Running
# P&R from the rc5 worktree, init_design died on
#   **ERROR: (TCLCMD-995): Can not open file '.../ASIC/romlibs/cc_rom/
#            rom_via_ss_1p08v_1p08v_125c.lib' for library set
# forty seconds into the place stage. read_mmmc reports it as an error on THIS
# file's line number, which is the only reason it was quick to find.
#
# $::env is visible in every Tcl context, which is why the override is written
# this way here rather than via a config.tcl global -- see the note above
# $design_home: this file is loaded by read_mmmc, not sourced.
set romlib_root [expr {[info exists ::env(ROMLIBS_DIR)]
                       ? $::env(ROMLIBS_DIR)
                       : "${design_home}/ASIC/romlibs"}]
set bootrom_path ${romlib_root}/cc_rom
set eth_rom_path ${romlib_root}/eth_rom

# SAY WHICH ONE, AND SAY IT BEFORE THE LIBRARY SETS ARE BUILT. A run that cannot
# name the ROM build it timed against cannot be attributed, and the two candidate
# directories hold macros whose Liberty differs only in a creation-date comment --
# so no downstream report would ever show which was read.
if {[info exists ::env(ROMLIBS_DIR)]} {
    set _romsrc "ROMLIBS_DIR -- this run's own ROM build"
} else {
    set _romsrc "the shared drop -- ROMLIBS_DIR is unset"
}
puts "mmmc: boot ROM macros from ${romlib_root} (${_romsrc})"
foreach {_rd _rn} [list ${bootrom_path} cc_rom ${eth_rom_path} eth_rom] {
    if {![file isdirectory $_rd]} {
        error "mmmc: no $_rn macro directory at $_rd\
             \n  source: $_romsrc\
             \n  Build this run's ROMs:  make -C ASIC -f common.mk rom-run ROM_RUN_DIR=$romlib_root"
    }
}
unset _rd _rn _romsrc
set IO_driver_path $::env(TSMC_65_HOME)/CMOS/LP/IO2.5V/iolib/STAGGERED/tphn65lpgv2od3_sl_210a_FE/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tphn65lpgv2od3_sl_210a/

# ---------------------------------------------------------------------------
# stdcell_nldm -- the standard-cell NLDM directory, DERIVED rather than
# respelled. Added 2026-08-29 while promoting two hold libsets into this file.
#
# WHY IT IS NOT WRITTEN OUT. The directory name is the release-coded name
# $base_path already carries on line 3, with the trailing _FE dropped. Spelling
# it again puts ANOTHER copy of a vendor release code into tracked content, and
# ASIC/asic-toolkit/ci/check-vendor-collateral.sh refuses that at commit (rule
# `ident`: a cell FAMILY name is public, a release code is a purchase order).
# It refused exactly this, twice, on the two libsets added at the foot of this
# file. Deriving the directory adds no new copy and collapses five repetitions
# of one path into one definition.
#
# NOT A GLOB. There is exactly one release directory installed on this host
# today, so a glob would work and would be shorter. It is still wrong: a second
# release appearing must change which libraries this design times against when
# somebody DECIDES it should, not silently on a directory-listing order.
#
# ASSERTED, because a wrong derivation would otherwise surface as ten missing
# libraries at init_design instead of as one wrong line here.
set stdcell_nldm ${base_path}/Front_End/timing_power_noise/NLDM/[string map {_FE {}} [lindex [file split ${base_path}] end-2]]
if {![file isdirectory ${stdcell_nldm}]} {
    error "mmmc: the derived standard-cell NLDM directory does not exist:\
           ${stdcell_nldm} -- it is \$base_path's release directory with _FE\
           removed. If the PDK layout changed, fix the derivation; do NOT\
           respell the release code, see the note above this line."
}

create_library_set -name default_libset_max\
   -timing\
    [list ${stdcell_nldm}/tcbn65lpwc.lib \
    ${rf_32k_path}/rf_32k_ss_1p08v_1p08v_125c.lib \
    ${rf_16k_path}/rf_16k_ss_1p08v_1p08v_125c.lib \
    ${rf_08k_path}/rf_08k_ss_1p08v_1p08v_125c.lib \
    ${rf_01k_path}/rf_01k_ss_1p08v_1p08v_125c.lib \
    ${flash_cache_data_path}/flash_cache_data_ss_1p08v_1p08v_125c.lib \
    ${flash_cache_tag_path}/flash_cache_tag_ss_1p08v_1p08v_125c.lib \
    ${bootrom_path}/rom_via_ss_1p08v_1p08v_125c.lib \
    ${eth_rom_path}/eth_rom_via_ss_1p08v_1p08v_125c.lib \
    ${IO_driver_path}/tphn65lpgv2od3_slwc.lib] \
   -si\
    [list ${base_path}/Back_End/celtic/tcbn65lp_200c/tcbn65lpwc.cdb]

create_library_set -name default_libset_min\
   -timing\
    [list ${stdcell_nldm}/tcbn65lplt.lib \
    ${rf_32k_path}/rf_32k_ff_1p32v_1p32v_m40c.lib \
    ${rf_16k_path}/rf_16k_ff_1p32v_1p32v_m40c.lib \
    ${rf_08k_path}/rf_08k_ff_1p32v_1p32v_m40c.lib \
    ${rf_01k_path}/rf_01k_ff_1p32v_1p32v_m40c.lib \
    ${flash_cache_data_path}/flash_cache_data_ff_1p32v_1p32v_m40c.lib \
    ${flash_cache_tag_path}/flash_cache_tag_ff_1p32v_1p32v_m40c.lib \
    ${bootrom_path}/rom_via_ff_1p32v_1p32v_m40c.lib \
    ${eth_rom_path}/eth_rom_via_ff_1p32v_1p32v_m40c.lib \
    ${IO_driver_path}/tphn65lpgv2od3_slbc.lib] \
   -si\
    [list ${base_path}/Back_End/celtic/tcbn65lp_200c/tcbn65lplt.cdb]

create_library_set -name typical_libset\
   -timing\
    [list ${stdcell_nldm}/tcbn65lptc.lib \
    ${rf_32k_path}/rf_32k_tt_1p20v_1p20v_25c.lib \
    ${rf_16k_path}/rf_16k_tt_1p20v_1p20v_25c.lib \
    ${rf_08k_path}/rf_08k_tt_1p20v_1p20v_25c.lib \
    ${rf_01k_path}/rf_01k_tt_1p20v_1p20v_25c.lib \
    ${flash_cache_data_path}/flash_cache_data_tt_1p20v_1p20v_25c.lib \
    ${flash_cache_tag_path}/flash_cache_tag_tt_1p20v_1p20v_25c.lib \
    ${bootrom_path}/rom_via_tt_1p20v_1p20v_25c.lib \
    ${eth_rom_path}/eth_rom_via_tt_1p20v_1p20v_25c.lib \
    ${IO_driver_path}/tphn65lpgv2od3_sltc.lib] \
   -si\
    [list ${base_path}/Back_End/celtic/tcbn65lp_200c/tcbn65lptc.cdb]


# ---------------------------------------------------------------------------
# PARASITIC EXTRACTION. Two problems are fixed here, both measured 2026-08-09.
#
# 1. THE CAP TABLES BELOW ARE FOR THE WRONG METAL STACK. `1p9m_6x2z` models a
#    two-thick-metal option; this design is 6X1Z1U - one 0.9um Z (M8) and one
#    3.4um U (M9), per PRTF_EDI_N65_9M_6X1Z1U_RDL.24a.tlef. 6x2z models M9 at
#    0.9um, i.e. wrong by 3.8x on the layer that carries the power grid and the
#    long routes. There is NO 6X1Z1U option in the ARM set (only 1p6m_4x1z,
#    1p7m_4x2z, 1p7m_5x1z, 1p8m_5x2z, 1p8m_6x1z, 1p9m_6x2z) and the TSMC PDK
#    ships no .captbl at all, so the cap tables cannot be made correct.
#
# 2. THERE IS A QRC DECK FOR THE EXACT STACK, AND THE FLOW SAID THERE WASN'T.
#    preplace.tcl:31-34 claims "No correct dataset exists here" - it looked only
#    in CMOS/util/, whose pack is 6X2Y. The stack-correct deck is:
#      /tsmc65pdk/65/CMOS/LP/pdk/Assura/online/1p9m_6X1Z1U/qrcTechFile  (178 MiB)
#    built from crn65lp_1p09m+alrdl_6x1z1u_typical.ict - `alrdl` = 14kA AP, which
#    is exactly the Europractice mini@sic common flow (1p9m_6x1z1u_MIM_APRDL).
#    Without it every post-route number reads "Parasitics Mode: No SPEF/RCDB"
#    with extract_rc_effort substituted to `low`, which is why the 5 -> 103
#    post-fill FEP swing cannot be separated into fill vs re-extraction.
#
# CAVEAT, STATED NOT BURIED: the deck on disk was generated from the TYPICAL
# ICT. Applying it to the worst and best corners is an improvement over a
# wrong-stack cap table, but it is NOT corner-correct. Corner-specific packs
# exist as tarballs at CMOS/util/T-N65-CL-SP-036-V1_11a/RC_QRC_cln65lp_1p09m+
# alrdl_{cbest,cworst,rcbest,rcworst,typical}.tar.gz; /tsmc65pdk is read-only, so
# they must be unpacked into the project tree and wired per corner before this
# is signoff-grade. VERIFY on the next run: IMPEXT-3518 must be absent and the
# timing report header must name a real RC corner.
#
# AND THE CAVEAT IS NOW MEASURED, 2026-09-01, because "not corner-correct" was
# being read as "approximately corner-correct" and it is neither. It is ONE
# CORNER wearing four names, and the number that follows from that is 0.
#
#   The ICT the deck was built from declares exactly one process block,
#   crn65lp_1p09m+alrdl_6x1z1u_typical, so there is no other interconnect model
#   inside it to select.
#   The routed database agrees: every one of the four rc_corners it saves
#   resolves -qrc_tech to the SAME PATH, libs/mmmc/rc_best_125C/qrcTechFile,
#   one symlink to the deck above. Innovus wrote a single per-corner directory
#   because there is a single file.
#   And the extraction agrees. On setupclose-20260829/sta_rc3setup, which wrote
#   three SPEFs from one run:
#       default_rc_corner_worst   125 C  rcworst captable
#       rc_best_125C              125 C  rcbest  captable
#       default_rc_corner_best    -40 C  rcbest  captable
#   the first two have BYTE-IDENTICAL bodies - same md5 over the capacitance
#   section AND the resistance section - so under post-route QRC the cap table
#   below is not consulted at all and choosing rcworst over rcbest changes
#   nothing. Across all three: 210,067 D_NETs and 4,528,778 capacitance entries,
#   967.7348 pF, identical to the last digit. The ONLY quantity that moves is
#   resistance, with -temperature: 8,684,727 ohm at 125 C against 6,162,102 ohm
#   at -40 C (a ratio of 1.409, i.e. an effective TCR near 0.0021/C), and the
#   only per-net difference in the capacitance section is the numbering of
#   internal nodes, which shifts because the resistive reduction did.
#
# WHAT FOLLOWS FOR CORNER COVERAGE. No additional analysis view can widen the
# RC axis of this signoff, whatever it is called, because there is one set of
# parasitics. A view whose claim to coverage is its rc_corner is measuring the
# same metal as the view next to it at a different temperature. Unpacking the
# corner packs above is the only thing that changes that, and until it is done
# "clean across all corners" means clean across one extraction.
set qrc_tech_file "/tsmc65pdk/65/CMOS/LP/pdk/Assura/online/1p9m_6X1Z1U/qrcTechFile"

create_rc_corner -name default_rc_corner_worst\
   -temperature 125\
   -pre_route_res 1\
   -post_route_res 1\
   -pre_route_cap 1\
   -post_route_cap 1\
   -post_route_cross_cap 1\
   -pre_route_clock_res 0\
   -pre_route_clock_cap 0\
   -cap_table ${tech_path}/cadence_captable/1p9m_6x2z/rcworst.captbl \
   -qrc_tech ${qrc_tech_file}

create_rc_corner -name default_rc_corner_best\
   -temperature -40\
   -pre_route_res 1\
   -post_route_res 1\
   -pre_route_cap 1\
   -post_route_cap 1\
   -post_route_cross_cap 1\
   -pre_route_clock_res 0\
   -pre_route_clock_cap 0\
   -cap_table ${tech_path}/cadence_captable/1p9m_6x2z/rcbest.captbl \
   -qrc_tech ${qrc_tech_file}

# ---------------------------------------------------------------------------
# rc_best_125C -- BEST-CASE METAL AT 125 C.  Added 2026-08-29 for rc5.
#
# WHY A FOURTH RC CORNER. The three above pair one cap table with one
# temperature: worst/125, best/-40, typical/25. That leaves the FAST-HOT hold
# corner unrepresentable -- FF silicon at 1.32 V and 125 C, whose metal is
# still best-case. It is not an exotic case: it is where a chip sits after it
# has been running, and av_ml_libset_hold below measured hold -0.078 ns on 22
# endpoints there, on a population DISJOINT from the -40 C one.
#
# It is default_rc_corner_best with the temperature changed and NOTHING else:
# same rcbest cap table, same qrcTechFile, same res/cap switches. Keep it that
# way -- the point of the corner is to move ONE variable.
create_rc_corner -name rc_best_125C\
   -temperature 125\
   -pre_route_res 1\
   -post_route_res 1\
   -pre_route_cap 1\
   -post_route_cap 1\
   -post_route_cross_cap 1\
   -pre_route_clock_res 0\
   -pre_route_clock_cap 0\
   -cap_table ${tech_path}/cadence_captable/1p9m_6x2z/rcbest.captbl \
   -qrc_tech ${qrc_tech_file}

create_rc_corner -name default_rc_corner_typical\
   -temperature 25\
   -pre_route_res 1\
   -post_route_res 1\
   -pre_route_cap 1\
   -post_route_cap 1\
   -post_route_cross_cap 1\
   -pre_route_clock_res 0\
   -pre_route_clock_cap 0\
   -cap_table ${tech_path}/cadence_captable/1p9m_6x2z/typical.captbl \
   -qrc_tech ${qrc_tech_file}


create_timing_condition -name tc_max \
   -library_sets {default_libset_max} 

create_timing_condition -name tc_min \
   -library_sets {default_libset_min} 

create_timing_condition -name tc_typ \
   -library_sets {typical_libset} 



### DELAY CORNERS ARE DECLARED TWO-SIDED, DELIBERATELY.
#
# Each corner below names -early_timing_condition AND -late_timing_condition
# explicitly, even where both sides use the same library set. That is
# SEMANTICALLY IDENTICAL to the single `-timing_condition` form it replaces --
# one library set for all delay calculation -- but it is NOT equivalent in how
# ccopt writes clock latency back, and that difference cost this design its hold
# closure.
#
# WHAT WENT WRONG (measured on the 2026-08-06 run; present in 2026-08-05 too):
#
# A hold check uses the LAUNCH clock's early/min path and the CAPTURE clock's
# late/max path. After CTS, ccopt_design writes the propagated tree delay back as
# a negative source latency so I/O timing stays consistent -- but it writes it
# PER VIEW, tagging only the sides that view actually has.
# default_analysis_view_hold used default_delay_corner_min, declared with a
# single `-timing_condition tc_min`, so the writeback emitted -min ONLY:
#
#   Clock: clk, View: default_analysis_view_hold, Propagated Latency: 1.07637
#    Executing: set_clock_latency -source -early -min -rise -1.07637 [get_pins CLK]
#    Executing: set_clock_latency -source -late  -min -rise -1.07637 [get_pins CLK]
#
# (Compare SWDCK, whose view carried both conditions: it got -min AND -max.)
#
# Harmless until scripts/route_setup.tcl sets `timing_analysis_type ocv` AFTER
# CTS. The min/max split then activates, the capture side finds no -max value and
# uses 0, and EVERY HOLD CHECK IN THE DESIGN LOSES 1.076 ns. The post-route hold
# path shows it directly: Src Latency capture 0.000 / launch -1.076.
#
# The cost was not subtle:
#   hold WNS -1.167 ns, TNS -66,212 ns, 96,545 violating paths
#   hold repair added +37,407 instances / +90,682 um2 chasing skew that is not there
#   density driven 83.6% -> 92.2%, which then BLOCKED DRV repair -- 153 max_tran
#     nets unfixable for "gain not enough" / "location check rejected" /
#     "max local density"
#
# And it was invisible: report_timing_summary emits NO hold section at all, and
# labels its own closing line `timing.setup.wns`. The headline "WNS +0.079,
# 0 failing endpoints" was setup only.
#
# The symmetric typical_analysis_view showed hold -0.116, so roughly 0.1 ns of
# hold violation is REAL and still needs ordinary repair. This fix removes the
# ~1.05 ns that was never there.
#
# STATUS 2026-08-07: THIS CHANGE DID NOT FIX THE HOLD PROBLEM. Recorded here so
# nobody spends another 5-hour run rediscovering it.
#
# The two-sided form is kept because it is more explicit and costs nothing, but
# the ccopt writeback is BYTE-IDENTICAL with and without it -- four lines for
# CLK in the hold view, all -min, no -max, in both runs:
#     -source -early -min -rise -1.07637 [get_pins CLK]
#     -source -late  -min -rise -1.07637 [get_pins CLK]
#     -source -early -min -fall -1.10823 [get_pins CLK]
#     -source -late  -min -fall -1.10823 [get_pins CLK]
# and post-CTS hold is identical too (WNS -0.577, 5,963 violating paths).
#
# The reason is simple in hindsight: `set_clock_latency -min/-max` is an SDC
# attribute of the CLOCK, not a property of the delay corner. Giving the corner
# two timing conditions does not give ccopt a second latency value to write.
# The missing -max has to be supplied explicitly -- see scripts/route_setup.tcl.
#
# DO NOT collapse these back to the single-condition form to tidy them up, and
# equally DO NOT expect them to fix hold on their own.
create_delay_corner -name default_delay_corner_max\
   -early_timing_condition {tc_max}\
   -late_timing_condition {tc_max}\
   -rc_corner default_rc_corner_worst

# default_delay_corner_ocv WAS DEFINED HERE AND IS DELETED WITH ITS VIEWS
# (2026-09-01). It bound tc_min early to tc_max late over
# default_rc_corner_typical, and the ONLY things that ever named it were
# typical_analysis_view_setup and typical_analysis_view_hold, retired below.
# Leaving the corner behind would leave the trap intact: the next reader finds
# a "corner" with no view and adds one.
#
# It also carried a defect of its own, and 3b_pnr_cts_eval.tcl:780-783 already
# names it: "for delay corners having different late and early library sets,
# only those set_timing_derate constraints are honored that are specified with
# late library set". It was the one two-sided corner in this file, so the
# early-side derate this flow depends on may never have applied to it - which
# is a second reason not to have signed anything off in a view built on it.
#
create_delay_corner -name default_delay_corner_min\
   -early_timing_condition {tc_min}\
   -late_timing_condition {tc_min}\
   -rc_corner default_rc_corner_best

create_delay_corner -name typical_delay_corner\
   -early_timing_condition {tc_typ}\
   -late_timing_condition {tc_typ}\
   -rc_corner default_rc_corner_typical

# ── THE IO RING'S SLEW LIMIT, ADDED AS A SECOND CONSTRAINT FILE ────────────
#
# The list below gained a second entry on 2026-08-31. The first is still the
# Genus-written consolidated constraint file and still carries everything the
# design is timed against. The second is P&R-only and does exactly one thing:
# it re-states the maximum transition limit on the chip boundary using Innovus's
# `-override`, which is the only mechanism that can beat the min() rule that
# `set_max_transition 0.300 [current_design]` imposes on every pin in the
# design including 96 pad-ring pins whose slew is an ASSERTION and cannot be
# routed away. The project constraint file (inputs/, the one Genus reads) names
# that remedy and cannot apply it, because Genus does not document -override.
# Read the header of the second file for the measured population and for what
# the exemption costs.
#
# ORDER MATTERS AND IS NOT ALPHABETICAL: -override only beats limits set BEFORE
# it, so the boundary file must come second.
#
# THIS IS READ ONCE, AT init_design, IN THE PLACE STAGE ONLY. Neither 3_cts.tcl
# nor 4_route.tcl calls read_mmmc -- they inherit the constraint mode from the
# database they read. A change here therefore does NOT reach a run resumed at
# cts or route; it needs place re-run. That is not a defect of this change, but
# it has caught people, so it is written down next to the change.
#
# ── THE TWO PATHS BELOW ARE SPELLED DIFFERENTLY ON PURPOSE ────────────────
#
# The FIRST is the consolidated constraint file SYNTHESIS wrote, and it belongs
# to whichever run this one is taking its synthesis from. That is
# $::env(ASIC_SYN_DIR), which mk/flow.mk derives from SYN_RUN_TAG. It used to be
# spelled ../outputs/ -- this run's outputs -- and the two are the same
# directory only when synthesis and placement happen under one run tag. Point
# SYN_RUN_TAG at another run and ../outputs is an EMPTY directory belonging to
# this run, so a reuse either dies on a missing file or, once somebody
# symlinks the missing products in to get past it, quietly times against
# whatever the symlinks happen to point at. Eight such symlinks exist under
# build/vt2-20260908/outputs today; with this spelling they are no longer
# needed.
#
# The SECOND stays RELATIVE, and that is not an oversight. <run>/inputs is a
# per-run symlink into that run's own pinned checkout, so ../inputs IS "this
# run's pinned P&R inputs" and following ASIC_SYN_DIR would take the pad-ring
# override from a different pin than the netlist it is applied to.
#
# Relative paths here resolve against the directory the tools are LAUNCHED in
# (the run's work/), which is also what `make check` resolves them against.
#
# A comment in this file MAY now name a constraint file. The flow resolves this
# mmmc by EVALUATING it in a throwaway interpreter -- see
# flow/common/mmmc_sdc.tcl -- rather than by regexing its text for anything
# ending .sdc, so prose is prose. Under the old text scrape, a "renamed from"
# note naming another .sdc aborted the place stage before it read a single
# library, and the warning that used to stand here was this project's
# workaround for that toolkit defect.
set __syn_dir [expr {[info exists ::env(ASIC_SYN_DIR)] && $::env(ASIC_SYN_DIR) ne ""
                     ? $::env(ASIC_SYN_DIR) : "../outputs"}]
set __mmmc_sdcs [list [file join $__syn_dir nanosoc_eth_chiplet_pads_syn.sdc]]
set __io_drv     ../inputs/pnr_io_drv.sdc
if {[file exists $__io_drv] && [file size $__io_drv]} {
    lappend __mmmc_sdcs $__io_drv
    puts "mmmc: IO-ring DRV override file included ($__io_drv)"
} else {
    puts "**WARN: mmmc: $__io_drv is missing or empty."
    puts "**WARN:   The design-scope max_transition 0.300 will apply to the pad"
    puts "**WARN:   ring as well, and this run will report ~96 max_transition"
    puts "**WARN:   endpoints on ports and uPAD_*/PAD pins that nothing in the"
    puts "**WARN:   design can fix. That is the pre-2026-08-31 behaviour, not a"
    puts "**WARN:   new failure - but the signoff budget for max_transition is 0."
}

create_constraint_mode -name default_constraint_mode\
   -sdc_files $__mmmc_sdcs
unset -nocomplain __mmmc_sdcs __io_drv __syn_dir

create_analysis_view -name default_analysis_view_setup -constraint_mode default_constraint_mode -delay_corner default_delay_corner_max
create_analysis_view -name default_analysis_view_hold -constraint_mode default_constraint_mode -delay_corner default_delay_corner_min

# ── THE TWO OCV VIEWS THAT USED TO BE HERE ARE RETIRED. 2026-09-01. ────────
#
# Deleted: typical_analysis_view_setup and typical_analysis_view_hold, both on
# default_delay_corner_ocv, both created here and named in NO set_analysis_view
# in this file, in flow/innovus/*, or in any hook. They were two of the seven
# views this file defined and two of the two that no stage of any run ever
# activated. They are inherited boilerplate: the same pair appears in seven
# sibling nanosoc MMMCs under nanosoc-multicore-system (28nm/38pin, 65nm
# 28/44/60pin, and their duplicates) and is activated in none of them either.
#
# REMOVING THEM IS NOT A BEHAVIOUR CHANGE. Nothing analysed them. eth-chiplet/
# hooks/pre_route.tcl finds the corners it derates by testing .is_active rather
# than by name, so it never saw them; the only trace they ever left in a log was
# IMPCTE-104, "the constraint mode of this inactive view has been modified and
# may need to be reanalyzed" - a warning that exists to tell you a view is not
# being analysed, and which this design has emitted on every run for months.
#
# THEY ARE NOT DELETED FOR BEING UNUSED - they are deleted because ACTIVATING
# them would have been worse than leaving them off, and "defined but inactive"
# is the state in which that is hardest to see. Activated by hand on rc5 the
# setup one read WNS -0.569 ns over 980 endpoints, and that number was carried
# for three days as the largest open timing item on the project. It is not one:
#
# 1. IT IS NOT AN RC CORNER, though the name and every previous write-up of it
#    said "typical interconnect versus worst interconnect". There is ONE
#    extraction in this design. All four rc_corners pass the same $qrc_tech_file
#    (see the note above them, extended 2026-09-01 with the measurement), and
#    the routed database records it as a single symlink that all four point at.
#    Measured on the three SPEFs of setupclose-20260829/sta_rc3setup: 4,528,778
#    capacitance entries totalling 967.7348 pF in EVERY corner, identical to the
#    last digit; the cap-table choice changes nothing under QRC (the worst/125C
#    and best/125C bodies are byte-identical); only resistance moves with
#    temperature, 8,684,727 ohm at 125 C against 6,162,102 ohm at -40 C.
#    So this view differed from default_analysis_view_setup in metal by 25 C of
#    resistance and in nothing else.
#
# 2. WHAT IT ACTUALLY DID was take EARLY delays from default_libset_min
#    (FF / 1.32 V / -40 C) and LATE delays from default_libset_max
#    (SS / 1.08 V / 125 C). For a setup check that puts the capture clock tree
#    at one global wafer-voltage-temperature corner and the data path, on the
#    same die at the same instant, at the opposite one. Process, supply and
#    temperature are die-global; no silicon is ever in both states. What such a
#    view is FOR is bounding on-chip variation - and this flow already models
#    that twice, with `timing_analysis_type ocv` plus CPPR plus the
#    0.95/1.05/0.97/1.03 derate that scripts/route_setup.tcl and
#    ASIC/sta/run_signoff_sta.tcl both re-issue. Activating it would have
#    replaced a 3% clock-variation model with a 150% one and sent
#    opt_design -post_route after 980 endpoints of it, at 85.7% utilisation
#    against a ~92.2% density wall. This design has done that once before: the
#    2026-08-06 phantom-hold episode above added 37,407 instances chasing skew
#    that was not there and blocked DRV repair for the rest of the run.
#
# 3. AND IT WAS NOT DE-EMBEDDED LIKE THE VIEWS IT WAS COMPARED WITH. ccopt
#    writes a per-view source-latency correction back at CTS for the views that
#    are ACTIVE then; these two never were, so the routed database binds a
#    latency file to the other five and none to these. Reg-to-reg paths are
#    unaffected (a uniform source latency cancels) but I/O paths are not, so
#    even the -0.569 was not like-for-like.
#
# IF YOU WANT THE NUMBER BACK, it is a scratchpad away and needs nothing from
# this file: generate a Tempus MMMC from a routed database with
# ASIC/sta/make_sta_mmmc.py, append the two create_analysis_view lines to the
# COPY, and activate them read-only. That is how the 2026-09-01 measurement was
# made. Recipe and results: docs/tapeout/66-rc5-flow-findings.md, F30.
#
# DO NOT PUT EITHER NAME IN ROUTE_VIEWS_SETUP OR ROUTE_VIEWS_HOLD in
# ASIC/eth-chiplet/design.mk. The views no longer exist, and 4_route.tcl:1564
# issues set_analysis_view after place and CTS have already been paid for.

create_analysis_view -name typical_analysis_view -constraint_mode default_constraint_mode -delay_corner typical_delay_corner

# ===========================================================================
# THE TWO HOLD CORNERS THAT WERE NOT IN THIS FILE.  Added 2026-08-29 (rc5).
# ===========================================================================
#
# WHY THEY ARE HERE. ASIC/sta/sta_policy.json names THREE required hold views:
# default_analysis_view_hold, av_ml_libset_hold and av_ltfix_libset_hold. Until
# this commit the last two existed in NO COMMITTED FILE -- only in generated
# MMMCs under gitignored build/ directories (build/holdfix-20260828/mmmc/ and
# build/setupclose-20260829/mmmc/, emitted by a gen_union_mmmc.py that is
# likewise untracked). A clean checkout therefore could not produce them, and
# the signoff gate would FAIL [VIEW_ABSENT] twice before saying anything at all
# about timing. Promoting them into this file is what makes the requirement
# reachable from a fresh clone.
#
# WHAT THEY MEASURE, AND WHY default_analysis_view_hold DOES NOT COVER IT.
#   av_ml_libset_hold     FF / 1.32 V / 125 C -- the FAST-HOT hold corner.
#                         Absent from this MMMC entirely until now. Measured
#                         hold -0.078 ns on 22 endpoints, a population DISJOINT
#                         from the -40 C one.
#   av_ltfix_libset_hold  the PVT-CORRECTED -40 C corner. default_libset_min
#                         above is NOT PVT-consistent: nine libraries at -40 C
#                         paired with tphn65lpgv2od3_slbc, which is 3.6 V / 0 C.
#                         Read nom_temperature out of both files and see. The
#                         3.6 V / -40 C part, tphn65lpgv2od3_sllt, sits unused
#                         in the same PDK directory. Measured hold -0.159 ns on
#                         3 RMII transmit endpoints.
# Neither number is visible in default_analysis_view_hold, and
# report_timing_summary -checks hold prints a single "View : ALL" row, so the
# aggregate hold WNS cannot tell you whether three views were folded into it or
# one. The view list is the only evidence.
#
# default_analysis_view_hold IS DELIBERATELY RETAINED even though its IO
# library is the 0 C one. sta_policy.json requires it, and keeping it makes the
# comparison against the earlier runs like-for-like. It is a superset of
# checks, never a substitute for the PVT-consistent ltfix view.
#
# EVERY LIBRARY BELOW WAS CHECKED ON DISK AND FOR PVT CONSISTENCY on
# 2026-08-29: nom_voltage / nom_temperature read out of each of the 20 files,
# 10/10 consistent per set (1.32 V core, 3.6 V IO, and the declared
# temperature). A corner built from cells at one temperature and memories at
# another is worse than no corner, because it looks like a measurement.
#
# NO -si SECTION, DELIBERATELY. The three libsets above each name a Celtic
# .cdb. These two do not, which matches the generated MMMCs that produced the
# -0.078 and -0.159 numbers. tcbn65lplt.cdb and tcbn65lpml.cdb both exist and
# could be added, but noise models are not what a fast-corner hold check turns
# on, and Tempus strips every -si section anyway (see ASIC/sta/make_sta_mmmc.py
# -- Celtic .cdb is rejected under concurrent MMMC, IMPESI-3490). Add them only
# with a run that shows they change a number.

create_library_set -name ltfix_libset\
   -timing\
    [list ${stdcell_nldm}/tcbn65lplt.lib \
    ${rf_32k_path}/rf_32k_ff_1p32v_1p32v_m40c.lib \
    ${rf_16k_path}/rf_16k_ff_1p32v_1p32v_m40c.lib \
    ${rf_08k_path}/rf_08k_ff_1p32v_1p32v_m40c.lib \
    ${rf_01k_path}/rf_01k_ff_1p32v_1p32v_m40c.lib \
    ${flash_cache_data_path}/flash_cache_data_ff_1p32v_1p32v_m40c.lib \
    ${flash_cache_tag_path}/flash_cache_tag_ff_1p32v_1p32v_m40c.lib \
    ${bootrom_path}/rom_via_ff_1p32v_1p32v_m40c.lib \
    ${eth_rom_path}/eth_rom_via_ff_1p32v_1p32v_m40c.lib \
    ${IO_driver_path}/tphn65lpgv2od3_sllt.lib]

create_library_set -name ml_libset\
   -timing\
    [list ${stdcell_nldm}/tcbn65lpml.lib \
    ${rf_32k_path}/rf_32k_ff_1p32v_1p32v_125c.lib \
    ${rf_16k_path}/rf_16k_ff_1p32v_1p32v_125c.lib \
    ${rf_08k_path}/rf_08k_ff_1p32v_1p32v_125c.lib \
    ${rf_01k_path}/rf_01k_ff_1p32v_1p32v_125c.lib \
    ${flash_cache_data_path}/flash_cache_data_ff_1p32v_1p32v_125c.lib \
    ${flash_cache_tag_path}/flash_cache_tag_ff_1p32v_1p32v_125c.lib \
    ${bootrom_path}/rom_via_ff_1p32v_1p32v_125c.lib \
    ${eth_rom_path}/eth_rom_via_ff_1p32v_1p32v_125c.lib \
    ${IO_driver_path}/tphn65lpgv2od3_slml.lib]

create_timing_condition -name tc_ltfix_libset \
   -library_sets {ltfix_libset}

create_timing_condition -name tc_ml_libset \
   -library_sets {ml_libset}

# Two-sided by the same rule as the corners above: see the long note there.
# Each is a single-libset MIN corner, so early and late name the same condition.
create_delay_corner -name dc_ltfix_libset_min\
   -early_timing_condition {tc_ltfix_libset}\
   -late_timing_condition {tc_ltfix_libset}\
   -rc_corner default_rc_corner_best

create_delay_corner -name dc_ml_libset_min\
   -early_timing_condition {tc_ml_libset}\
   -late_timing_condition {tc_ml_libset}\
   -rc_corner rc_best_125C

create_analysis_view -name av_ltfix_libset_hold -constraint_mode default_constraint_mode -delay_corner dc_ltfix_libset_min
create_analysis_view -name av_ml_libset_hold    -constraint_mode default_constraint_mode -delay_corner dc_ml_libset_min

# ---------------------------------------------------------------------------
# ACTIVE VIEWS.
#
# THIS LINE IS NOT WHAT THE SIGNOFF GATE COUNTS. Read that twice before
# changing it. It governs place and CTS. flow/innovus/4_route.tcl:1564,1618
# RE-ISSUES set_analysis_view from $ROUTE_VIEWS_SETUP / $ROUTE_VIEWS_HOLD
# immediately before write_db, so the view set the routed database is SAVED
# with -- and therefore the set ASIC/sta/make_sta_mmmc.py derives the Tempus
# MMMC from, and therefore the set sta_policy.json checks -- is whatever
# design.mk sets those two knobs to. The toolkit defaults them to ONE hold view
# (4_route.tcl:153), and ASIC/eth-chiplet/design.mk deliberately sets nothing.
#
# So defining the views here is necessary and NOT sufficient. For rc5,
# design.mk must also carry
#     export ROUTE_VIEWS_HOLD ?= default_analysis_view_hold \
#                                av_ltfix_libset_hold av_ml_libset_hold
# or the two corners promoted above are defined, inactive at route, absent from
# the saved database, and the gate fails VIEW_ABSENT exactly as it does today.
# The evidence that this is how it works: the exported viewDefinition.tcl of
# every routed database so far ends
#     set_analysis_view -setup [list default_analysis_view_setup] \
#                       -hold  [list default_analysis_view_hold]
# which is NOT this line -- typical_analysis_view is missing from it.
#
# typical_analysis_view is kept active here. It is not a signoff corner, but
# eth-chiplet/hooks/pre_route.tcl derates the ACTIVE corners by name and its
# header documents three of them; dropping one is a behaviour change with no
# measurement behind it. Adding the two hold views is additive.
#
# COUNTING THE VIEWS ON THIS LINE - the trap, measured 2026-09-01. It names
# SIX list entries but activates FIVE views, because typical_analysis_view is
# in both roles and a view named twice is still one view. That distinction is
# load-bearing downstream: `get_db clocks` returns one object per SDC clock per
# DISTINCT ACTIVE VIEW, and ASIC/sta/sta_policy.json grades the result. On a
# read-only copy of rc6full-20260831 with 26 SDC clocks: setup{1} hold{3} = 4
# views = 104 clocks; setup{2} hold{4} with one shared = 5 views = 130; the
# same five with no overlap = 130 again; all seven = 182. Six entries and five
# entries give the same number, so count views, not entries.
set_analysis_view -setup [list default_analysis_view_setup typical_analysis_view] -hold [list default_analysis_view_hold av_ltfix_libset_hold av_ml_libset_hold typical_analysis_view]
