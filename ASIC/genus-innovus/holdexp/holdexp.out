@file 131: set TECH_LEF $::env(TSMC_65_HOME)/CMOS/util/lef/PRTF_EDI_65nm_001_Cad_V24a/PRTF_EDI_N65_9M_6X1Z1U_RDL.24a.tlef
@file 132: #$::env(PHYS_IP)/arm/tsmc/cln65lp/arm_tech/r2p0/lef/1p9m_6x2z/sc12_tech.lef
@file 133: set BASE_LEF $::env(TSMC_65_HOME)/CMOS/LP/stclib/9-track/tcbn65lp-set/tcbn65lp_220a_FE/TSMCHOME/digital/Back_End/lef/tcbn65lp_200a/lef/tcbn65lp_9lmT2.lef
@file 134: set IO_PAD_LEF $::env(TSMC_65_HOME)/iolib/tpbn65v_200b_FE/TSMCHOME/digital/Back_End/lef/tpbn65v_200b/cup/9m/9M_6X1Z1U/lef/tpbn65v_9lm.lef
@file 135: # LOCAL OVERRIDE of the TSMC IO driver LEF â three added lines, nothing else.
@file 136: #
@file 137: # The IO supply pads declare their supply pins as plain signal pins:
@file 138: #     PIN VDDPST / DIRECTION INOUT ;      (PVDD2DGZ_G, PVDD2POC_G)
@file 139: #     PIN VSSPST / DIRECTION INOUT ;      (PVSS2DGZ_G)
@file 140: # with no `USE POWER ;` / `USE GROUND ;`. The liberty agrees â they are pin()
@file 141: # groups, not pg_pin(). So `connect_global_net -type pg_pin` cannot match them,
@file 142: # and the VDDIO/VSSIO global-net rules failed with IMPDB-1221.
@file 143: #
@file 144: # Consequence, stated by NanoRoute itself (NRDB-51): the VDDIO/VSSIO
@file 145: # SPECIAL_NETs stayed empty, so the router treated the IO supplies as ORDINARY
@file 146: # SIGNAL NETS and threaded them around the periphery into the bond-pad M8/M9
@file 147: # blockages. Every VDDIO/VSSIO DRC record is a "Regular Wire"; VDD/VSS have
@file 148: # none. That was 76 violations.
@file 149: #
@file 150: # Verified, not assumed: correcting -pin_base_name alone is NOT sufficient.
@file 151: # `connect_global_net VDDIO -type pg_pin -pin_base_name VDDPST` still raises
@file 152: # IMPDB-1221 against a design loaded from the real DB, because the pin is not
@file 153: # classified as power. The LEF has to say so.
@file 154: #
@file 155: # Copied from $TSMC_65_HOME/.../tphn65lpgv2od3_sl_9lm.lef with `USE POWER ;` /
@file 156: # `USE GROUND ;` inserted after DIRECTION on exactly those three pins. The
@file 157: # shared PDK under /tsmc65pdk is READ-ONLY and is not modified â see the
@file 158: # read-only-filesystem rule in CLAUDE.md. Re-copy and re-apply if the PDK
@file 159: # revs; `diff` against the source shows only the three added lines.
@file 160: set IO_PAD_DRIVER_LEF $::env(NANOSOC_ETH_CHIPLET_HOME)/ASIC/tech_wrappers/tsmc65/local_overrides/tphn65lpgv2od3_sl_9lm.lef
@file 161:
@file 162:
@file 163: # !! THESE SHOULD BE CORRECT FOR ANY ENVIRONMENT AS THEY ARE GENERATED BY MAKEFILE
@file 164: set RF32_LEF $rf_32k_dir/rf_32k.lef
@file 165: set RF16_LEF $rf_16k_dir/rf_16k.lef
@file 166: set RF8_LEF $rf_08k_dir/rf_08k.lef
