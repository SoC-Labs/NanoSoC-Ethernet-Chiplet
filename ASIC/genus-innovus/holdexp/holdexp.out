@file 1: # Helper: expand ${VAR} and $(VAR) references to environment variable values.
@file 2: # The hand-maintained project flists use ${VAR}; the nanosoc_gen-emitted flists
@file 3: # (build_soc/flist/*.flist, which the ASIC flist -f-includes) use make-style
@file 4: # $(VAR). Support both so the generator's native filelists can be -f'd directly
@file 5: # (keeps the interconnect leaf list auto-in-sync instead of hand-inlined).
@file 6: proc expand_env {str} {
    while {[regexp {\$\{(\w+)\}} $str -> varname]} {
        if {[info exists ::env($varname)]} {
            set pattern "\\$\\{${varname}\\}"
            regsub $pattern $str $::env($varname) str
        } else {
            error "Environment variable $varname is not set"
        }
    }
    while {[regexp {\$\((\w+)\)} $str -> varname]} {
        if {[info exists ::env($varname)]} {
            set pattern "\\$\\(${varname}\\)"
            regsub $pattern $str $::env($varname) str
        } else {
            error "Environment variable $varname is not set"
        }
    }
    return $str
}
#@ End verbose source ../scripts/procs.tcl
@file 2:
@file 3: set process_node 65
@file 4:
@file 5: # ââ check_cpf must not abort the script âââââââââââââââââââââââââââââââââââââ
@file 6: # 1_synthesis.tcl runs `check_cpf` between apply_power_intent and
@file 7: # commit_power_intent. On this design it reports 91 low-power rule errors and
@file 8: # raises RCLP-203, which ABORTS the -f script. Genus then drops to its
@file 9: # interactive prompt and, because an unattended run has stdin on /dev/null,
@file 10: # exits 0 having written no netlist.
@file 11: #
@file 12: # This is not new and it is not caused by the RTL: the 2026-07 reference run
@file 13: # hit RCLP-203 with the IDENTICAL error counts (34 / 1 / 54 / 2). It produced a
@file 14: # netlist only because it was driven by hand â its log shows commit_power_intent
@file 15: # and set_dont_touch typed at the `@genus:root:` prompt after the abort. So
@file 16: # 1_synthesis.tcl has never once completed unattended.
@file 17: #
@file 18: # clp_treat_errors_as_warnings is the remedy the RCLP-203 text names. Do NOT
@file 19: # reach for it: it is accepted by Genus but does NOT stop check_cpf raising on
@file 20: # this design (verified â a run that set it aborted at the same line with the
@file 21: # same four Severity: Error blocks), AND it is a Genus-only root attribute, so
@file 22: # under Innovus it fails with IMPDBTCL-247 and takes this whole file down with
@file 23: # it. THIS FILE IS SOURCED BY BOTH TOOLS: config.tcl is read by 1_synthesis.tcl
@file 24: # under Genus and by 2_pnr_setup / 3_pnr_clock / 4_pnr_route under Innovus, so
@file 25: # anything tool-specific here must be guarded or it breaks the other one.
@file 26: #
@file 27: # The abort is therefore stopped directly, by wrapping check_cpf so a
@file 28: # rule-check failure cannot kill the -f script.
@file 29: #
@file 30: # The wrapper is the scripted equivalent of what the reference run did by hand.
@file 31: # It does NOT fix or hide anything: check_cpf still runs, still writes full
@file 32: # detail to logs/syn_cpf_check.log, and the failure is echoed to stderr where
@file 33: # the main log will show it.
@file 34: # What is being tolerated, all pre-existing:
@file 35: #   34x 1801_REF_OBJ_NOT_FOUND      UPF connect_supply_net naming macro PG ports
@file 36: #                                   (rf_sp_hdf / cache RAM VDD,VSS) that the
@file 37: #                                   liberty models do not expose
@file 38: #   54x + 1x                        pad/macro PG pins with no create_supply_port
@file 39: #                                   or PG-pin attributes
@file 40: #    2x STRUCT_UNDRIVEN_PIN_MACRO   REAL: the QSPI flash-cache tag RAMs have an
@file 41: #                                   undriven GWEN --
@file 42: #                                   u_qspi_flash_0/.../u_way{0,1}_cache_ram/
@file 43: #                                   tag_ram_0_i/GWEN. Worth fixing in ahb_qspi;
@file 44: #                                   it is in the reference GDSII too.
@file 45: # Set here, in the project's own config, rather than in the shared asic-flows
@file 46: # 1_synthesis.tcl, which other designs use.
@file 47: #
@file 48: # Guarded on both sides: under Innovus check_cpf does not exist and a bare
@file 49: # `rename` would itself abort the script. The second test makes re-sourcing
@file 50: # idempotent.
@file 51: if {[llength [info commands check_cpf]]
@file 52:     && ![llength [info commands _check_cpf_unwrapped]]} {...}
