# Site-local tool locations for the signoff STA run set.
#
#   cp site.env.example site.env    and edit for your site.
#
# site.env is gitignored. This repository is PUBLIC, so absolute paths into a
# licensed EDA install do not belong in it — same reasoning as
# ASIC/asic-flows/site.env.example, and the commit hook enforces it.
#
# Both variables may also be set in the environment instead; the environment
# wins over site.env.

# Full path to the Tempus executable.
# Must be the SSV release that MATCHES the Innovus that wrote the database
# being analysed (21.11 for this design). A mismatched Tempus may refuse the
# database or, worse, read it and be subtly wrong.
TEMPUS_BIN=/path/to/SSV_<version>/bin/tempus

# Root of the Quantus install. Tempus does NOT ship an extractor: it shells out
# to `qrc`, and without this it fails with
#   IMPEXT-5016: Command qrc failed ... failed to run: No such file or directory
#
# Point this at the Quantus whose version matches the Tempus above. Several
# older EXT_* installs also provide a `qrc`, and a stale PATH will find one of
# them first — a 2015-vintage extractor against a 21.11 database is a
# silent-wrong-answer risk, not a crash.
QUANTUS_HOME=/path/to/QUANTUS_<version>
