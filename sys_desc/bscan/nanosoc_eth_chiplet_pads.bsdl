    "34 (BC_1, QSPI_SCLK, output2, X),"               &  -- uPAD_QSPI_SCLK data
    "35 (BC_1, QSPI_nCS, output2, X),"                &  -- uPAD_QSPI_nCS data
    "36 (BC_1, RMII_MDC, output2, X),"                &  -- uPAD_RMII_MDC data
    "37 (BC_4, RMII_REF_CLK, input, X),"              &  -- uPAD_RMII_REF_CLK obs
    "38 (BC_4, RMII_RXD(0), input, X),"               &  -- uPAD_RMII_RXD0 obs
    "39 (BC_4, RMII_RXD(1), input, X),"               &  -- uPAD_RMII_RXD1 obs
