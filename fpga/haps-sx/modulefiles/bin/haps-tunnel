#!/bin/sh
# haps-tunnel  up|down|status
# ONE ref-counted SSH ControlMaster to the HAPS bench jump host (haps-dev),
# carrying BOTH bench forwards over a single connection:
#   -L 3121 : localhost:3121   JTAG   -> hw_server ON haps-dev   (O2: Digilent cable -> hw_server)
#   -L 18000: haps-sx:18000    ConfPro-> the BOARD, through haps-dev
# Best-effort: it must NEVER block or fail a `module load`. ControlPersist reaps a
# leaked master (crash-safe); the ref-count just closes it promptly on the last `down`.
# ExitOnForwardFailure=yes on BOTH channels. An earlier revision omitted it,
# reasoning that "the board-side 18000 forward connects lazily, so a rebooting
# board must not tear down the JTAG forward". That is simply wrong -- ssh_config(5)
# is explicit: it "does not apply to connections made over port forwardings and
# will not, for example, cause ssh(1) to exit if TCP connections to the ultimate
# forwarding destination fail." It fires ONLY on bind/listen failure. Omitting it
# bought nothing and cost everything: when another user (or a stray hw_server)
# already held a port, ssh backgrounded successfully with a DEAD forward, said
# "up", and the tools then silently used the other user's forward on the other
# user's credential. Measured live on srv03335.
#
# Two SEPARATE masters, because `ssh -O forward` returns 0 even when the bind
# fails (measured), so per-forward failure cannot be detected on one connection.
# Splitting them means a stray hw_server on 3121 can no longer take ConfPro down
# with it -- each channel succeeds or fails loudly on its own.
#
# TCP 18000 DRIVES a board but does not DESCRIBE one: ConfPro reads board state
# over UDP (query to 18009, reply to local 18008 -- SearchCABNet::touchBorad),
# and `ssh -L` cannot carry UDP. Without that channel the GUI has only the six
# identity fields seeded into its systems list, so the Used/Idle column, the
# User-IP label and the "Board is Busy" interlock are all dead -- and because
# on_selectButton_clicked() gates that popup on the UDP-sourced `control` flag,
# a board somebody else holds is listed as a normal white "Idle" row and the
# GUI connects to it. haps-state-relay carries the channel, and is driven from
# here so it shares this script's ref-count and lifetime.
set -u
SSH_TARGET="${HAPS_TUNNEL_SSH:-haps-dev}"            # override to a de-privileged account (see README)
JTAG_LP="${HAPS_JTAG_LOCALPORT:-3121}"; JTAG_RHOST="${HAPS_JTAG_RHOST:-localhost}"; JTAG_RPORT="${HAPS_JTAG_RPORT:-3121}"
CONF_LP="${HAPS_CONFPRO_LOCALPORT:-18000}"; CONF_RHOST="${HAPS_CONFPRO_RHOST:-haps-sx}"; CONF_RPORT="${HAPS_CONFPRO_RPORT:-18000}"
# CTRL stays the BOARD channel: haps-state-relay multiplexes its helper on it.
CTRL="${HAPS_TUNNEL_CTRL:-$HOME/.ssh/cm-haps-tunnel}"
CTRL_JTAG="${HAPS_TUNNEL_CTRL_JTAG:-$HOME/.ssh/cm-haps-jtag}"
# Bind address is PINNED and explicit. Without it ssh binds dual-stack, and a v4
# collision is silently masked by a successful [::1] bind -- ExitOnForwardFailure
# only fires when NO address binds at all. Measured: a squatter on 127.0.0.1:3121
# still let the tunnel report "up" on ::1. `localhost` also resolves to ::1 FIRST
# here (getent ahosts), so every consumer URL must be numeric too.
MYUID=$(id -u)
BIND_NOTE=""
BIND_SRC=default

# --- per-user loopback address (OPT-IN; the default is still 127.0.0.1) -------
# 127.<(uid>>16)&0xff>.<(uid>>8)&0xff>.<uid&0xff>, so uid 74755 -> 127.1.36.3.
# The whole of 127/8 is loopback, so each user on a workstation can own an entire
# address and bind :18000, :3121 and the relay's :18009 on it without asking
# anybody. Today they all bind 127.0.0.1, and because ExitOnForwardFailure=yes is
# (correctly) set, the SECOND user to load the module gets no tunnel at all --
# not a degraded one -- until the first unloads.
#
# WHY THIS SHIPS DISABLED. TWO prerequisites, both measured 2026-08-27 against
# the deployed tools rather than inferred. Either one alone is enough to keep
# the default at 127.0.0.1; do not flip it until BOTH are closed.
#
# (1) The board reservation is still keyed on the transport endpoint, not on
#     the board:
#   /research/CAD/SoC-Labs-ConfPro-SX/haps-board-lock:54
#       board=${CONFPRO_BOARD:-haps-sx.haps-net}    <- and HAPS_LOCK_KEY appears
#                                                      nowhere in that script
#   /research/CAD/haps-locks/audit.log
#       2026-08-27T11:44:21Z ad1u25@srv03335  acquired 127.0.0.1 for 10m
#       2026-08-27T12:57:24Z dam1n19@srv03335 acquired 127.0.0.1 for 10m
# So the lease every user contends for today IS the file 127.0.0.1.lock. Making
# the bind per-user necessarily makes CONFPRO_BOARD per-user too (the tools have
# to follow the tunnel), and each user would then quietly take their OWN
# 127.x.y.z.lock -- at which point the one piece of cross-user coordination that
# actually works on this bench stops excluding anyone, and two people drive one
# board with both GUIs painting "Idle". A port collision is loud and costs you
# your tunnel; a split lease is silent and costs somebody else their run. Hence
# opt-in via HAPS_PER_USER_BIND=1. Closing (1) means haps-board-lock keying on
#     HAPS_LOCK_KEY -- haps-state-relay already prefers it (see its Helper
#     `keys` list); it is only the lock tool that lags.
#
# (2) The ConfPro launcher's port probes are ADDRESS-BLIND. confpro-sx-shadow's
#     port_listening()/port_holder()/port_is_ssh() (lines 137/159/171) all ask
#     `ss -ltn "sport = :$1"` -- "is ANY address listening on this port". While
#     everyone binds 127.0.0.1 that question and "is MY tunnel up" have the same
#     answer, so it works by coincidence. Per-user addresses break the identity.
#     Reproduced here with a listener on 127.1.36.3:19477 only:
#         ss -ltn "sport = :19477"          -> MATCHES (user A's listener)
#         ss -ltn "src 127.0.175.110:19477" -> no match (user B has nothing)
#     so B's launcher concludes a tunnel exists, sets board_ip to an address
#     nothing of B's is bound to, and the GUI never reaches the board -- with no
#     error and no warning. Note B CAN still bind its own address fine (verified):
#     nothing actually collides, only the probe is wrong, which is exactly what
#     makes this failure silent rather than loud. Closing (2) means qualifying
#     those three filters by address (plus the 0.0.0.0 / [::] wildcard clauses,
#     since a wildcard holder does not match a bind-specific filter yet still
#     makes a per-user bind fail EADDRINUSE).
#
# HAPS_TUNNEL_BIND still overrides both, unconditionally.
per_user_bind(){
    _u=$1
    # Only 24 bits fit in 127.x.y.z. Directory-service uids (SSSD/AD) routinely
    # exceed 0xffffff, so FOLD the high bits in rather than truncate: truncation
    # would silently hand uid 200000 and uid 16977216 the same address. The fold
    # is the identity for every uid <= 0xffffff, so the documented mapping
    # (74755 -> 127.1.36.3) is unchanged by it.
    _low=$(( (_u ^ (_u >> 24)) & 0xffffff ))
    if [ "$_u" -gt 16777215 ]; then
        BIND_NOTE="uid $_u needs more than 24 bits - address is fold-derived: unique on this host, not guaranteed estate-wide"
    fi
    # Five low values do not give a usable PRIVATE address:
    #        0 -> 127.0.0.0         the /8 network address
    #        1 -> 127.0.0.1         the shared default this exists to get off
    #       53 -> 127.0.0.53        systemd-resolved stub listener
    #       54 -> 127.0.0.54        systemd-resolved extra listener
    #  0xffffff -> 127.255.255.255  the /8 broadcast -- and haps-state-relay does
    #                               sendto(LOCAL_IP, 18008), so a board-state
    #                               reply would go to EVERY ConfPro on the host
    #                               instead of to the one that asked.
    # Linux binds all five perfectly happily (measured), which is precisely why
    # they have to be excluded HERE rather than left to fail loudly later.
    # Escape by flipping bit 23 (second octet ^= 0x80): deterministic, and it
    # leaves the excluded set in ONE step for every member, so no loop is needed:
    #   0 -> 127.128.0.0   1 -> 127.128.0.1   53 -> 127.128.0.53
    #  54 -> 127.128.0.54  0xffffff -> 127.127.255.255
    case "$_low" in
        0|1|53|54|16777215)
            _low=$(( _low ^ 0x800000 ))
            BIND_NOTE="${BIND_NOTE:+$BIND_NOTE; }uid $_u derives a reserved address - escaped into the 127.128/9 block" ;;
    esac
    BIND="127.$(( (_low >> 16) & 0xff )).$(( (_low >> 8) & 0xff )).$(( _low & 0xff ))"
}
if [ -n "${HAPS_TUNNEL_BIND:-}" ]; then
    BIND="$HAPS_TUNNEL_BIND"; BIND_SRC=HAPS_TUNNEL_BIND   # explicit wins over everything
elif [ "${HAPS_PER_USER_BIND:-0}" = 1 ]; then
    per_user_bind "$MYUID";  BIND_SRC="per-user, uid $MYUID"
else
    BIND=127.0.0.1;          BIND_SRC=default             # historical shared -- see above
fi
# The relay has to land on the SAME address as the forwards, or ConfPro drives
# the board through one address and reads its state from another. The modulefile
# setenv's this as well; doing it here too keeps a bare `haps-tunnel up`
# coherent for anyone not going through Modules.
export HAPS_STATE_LOCAL_IP="${HAPS_STATE_LOCAL_IP:-$BIND}"
REF="${XDG_RUNTIME_DIR:-/tmp}/.haps-tunnel.ref.$MYUID"
LK="${XDG_RUNTIME_DIR:-/tmp}/.haps-tunnel.lk.$MYUID"
CTIMEOUT="${HAPS_TUNNEL_CONNECT_TIMEOUT:-5}"; PERSIST="${HAPS_TUNNEL_PERSIST:-10m}"
RELAY="${HAPS_STATE_RELAY_BIN:-$(dirname "$(readlink -f "$0")")/haps-state-relay}"
TAG=haps-tunnel
lock(){ i=0; while ! mkdir "$LK" 2>/dev/null; do i=$((i+1)); [ $i -gt 50 ] && break; sleep 0.1; done; }
unlock(){ rmdir "$LK" 2>/dev/null || true; }
say(){ echo "$TAG: $*" >&2; }
sshc(){ ssh -o BatchMode=yes -o ControlPath="$CTRL" "$@"; }
sshj(){ ssh -o BatchMode=yes -o ControlPath="$CTRL_JTAG" "$@"; }
alive(){ sshc -O check "$SSH_TARGET" 2>/dev/null; }
alive_jtag(){ sshj -O check "$SSH_TARGET" 2>/dev/null; }

# Open one channel. $1=ControlPath $2=forward spec $3=label. Reports precisely
# which channel failed and why -- the whole point of ExitOnForwardFailure here.
open_chan(){
    _ctl=$1; _fwd=$2; _label=$3
    _ctl_tag=$(basename "$_ctl")
    # stderr to a FILE, never a $(...) pipe: `ssh -f` daemonises and keeps the
    # inherited stderr open, so command substitution blocks forever waiting for
    # EOF on a master that is meant to persist. (Learned the hard way.)
    _tmp="${XDG_RUNTIME_DIR:-/tmp}/.haps-tunnel.err.$$.$_ctl_tag"
    timeout "$((CTIMEOUT + 3))" ssh -f -N \
             -o BatchMode=yes -o ConnectTimeout="$CTIMEOUT" \
             -o ExitOnForwardFailure=yes \
             -o ServerAliveInterval=30 -o ServerAliveCountMax=4 \
             -o ControlMaster=auto -o ControlPath="$_ctl" -o ControlPersist="$PERSIST" \
             -L "$_fwd" "$SSH_TARGET" 2>"$_tmp" \
        && { rm -f "$_tmp"; say "up: $_label"; return 0; }
    _err=$(cat "$_tmp" 2>/dev/null); rm -f "$_tmp"
    case "$_err" in
        *"Address already in use"*)
            say "WARN $_label NOT started - the local port is already held by another"
            say "     process (another user's tunnel, or a stray hw_server). Yours is NOT"
            say "     running; anything you do would have gone through theirs." ;;
        *) say "WARN $_label NOT started (off-network / no key?) - tools still usable" ;;
    esac
    return 1
}
# The UDP board-state relay. Absent or broken must never affect the tunnel.
relay(){ [ -x "$RELAY" ] || return 0; "$RELAY" "$@" || true; }
case "${1:-}" in
  up)
    [ "${HAPS_NO_TUNNEL:-0}" = 1 ] && { say "disabled (HAPS_NO_TUNNEL=1)"; exit 0; }
    # Say which address, but only when it is NOT the historical shared one: a
    # per-user bind is the thing a second user needs to see in the log when they
    # are working out why their ConfPro talks to a different endpoint than the
    # wiki says. Silent on the default so routine loads stay quiet.
    [ "$BIND" = 127.0.0.1 ] || say "binding $BIND ($BIND_SRC)"
    [ -n "$BIND_NOTE" ] && say "note: $BIND_NOTE"
    lock; n=$(cat "$REF" 2>/dev/null || echo 0); n=$((n+1)); echo "$n" > "$REF"; unlock
    # Board channel first -- it is the one ConfPro needs, and the relay rides it.
    alive || open_chan "$CTRL" "${BIND}:${CONF_LP}:${CONF_RHOST}:${CONF_RPORT}" \
                       "${BIND}:${CONF_LP} (ConfPro -> board) via ${SSH_TARGET}"
    alive_jtag || open_chan "$CTRL_JTAG" "${BIND}:${JTAG_LP}:${JTAG_RHOST}:${JTAG_RPORT}" \
                       "${BIND}:${JTAG_LP} (JTAG -> hw_server) via ${SSH_TARGET}"
    relay up
    ;;
  down)
    lock; n=$(cat "$REF" 2>/dev/null || echo 1); n=$((n-1)); [ "$n" -lt 0 ] && n=0; echo "$n" > "$REF"; unlock
    [ "$n" -le 0 ] && { relay down
                        sshc -O exit "$SSH_TARGET" 2>/dev/null || true
                        sshj -O exit "$SSH_TARGET" 2>/dev/null || true
                        rm -f "$REF"; }
    ;;
  status)
    alive      && echo "board channel (${BIND}:${CONF_LP}) up" || echo "board channel (${BIND}:${CONF_LP}) down"
    alive_jtag && echo "jtag  channel (${BIND}:${JTAG_LP}) up" || echo "jtag  channel (${BIND}:${JTAG_LP}) down"
    relay status ;;
  bind)
    # Read-only: no ssh, no relay, no ref-count. Prints the address THIS
    # invocation would bind, honouring HAPS_TUNNEL_BIND / HAPS_PER_USER_BIND.
    # `haps-tunnel bind <uid>` answers for another uid instead, which is what
    # the modulefile cross-check and any rollout table should use -- so they
    # quote the shipping derivation rather than a second copy of it.
    if [ -n "${2:-}" ]; then BIND_NOTE=""; per_user_bind "$2"; fi
    [ -n "$BIND_NOTE" ] && say "note: $BIND_NOTE"
    echo "$BIND" ;;
  *) say "usage: $0 {up|down|status|bind [uid]}"; exit 2 ;;
esac
