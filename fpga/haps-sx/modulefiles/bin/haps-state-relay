#!/usr/bin/env python3
"""haps-state-relay -- carry ConfPro-SX's UDP board-state channel over ssh.

ConfPro-SX drives a board over TCP 18000, but it *displays* one over UDP:

    -> board:18009   {"Cobra System Search Device": "<board ip>"}
    <- local :18008  *** CA BOARD SEARCHING FEEDBACK ***{ ...25 fields... }

That is SearchCABNet::touchBorad(), the call the GUI uses to refresh a manually
added board -- which is exactly the seeded entry a tunnelled user has. `ssh -L`
is TCP-only, so on a tunnelled host the query goes nowhere and the reply never
arrives: the Systems List shows the row (seeded from boardinfolist.json, 6
identity fields) but the board panel has no data and renders grey. The GUI
cannot even report the board as busy, because `control`/`controller` -- the
pair behind the "Board is Busy" popup -- are two of the 19 state fields that
only ever arrive on this channel.

This relay restores it without a VPN, a tun device or root:

    GUI --UDP--> 127.0.0.1:18009 (us) --ssh--> haps-dev --UDP--> board:18009
    GUI <--UDP-- 127.0.0.1:18008 (us) <--ssh-- haps-dev <--UDP-- board:18008

Three things it must get right, all of them load-bearing:

  * It must NEVER bind 18008. The GUI binds that port exclusively while its
    System Selection dialog is open; the relay only ever sendto()s it.
  * The reply is sent FROM 127.0.0.1:18009 -- the same socket the query
    arrived on -- so the source address matches the board entry the GUI is
    refreshing, exactly as a real board's reply would.
  * "active ip" is rewritten to the local endpoint. The GUI matches rows on
    "board id" (the MAC) and takes the address from the payload, so relaying
    the board's own 10.60.1.10 would overwrite the working tunnel address with
    one that has no route from here -- breaking the TCP 18000 path that
    currently works. "host ip list" is rewritten for the same reason.

Fail-open everywhere, like the rest of the bench tooling: if the jump host is
unreachable, the helper dies, or the board does not answer, the relay stays up
and simply does not reply. ConfPro then behaves exactly as it does today.

    haps-state-relay up        start the daemon (idempotent; bind is the mutex)
    haps-state-relay down      stop it
    haps-state-relay status    up|down, and where it points
    haps-state-relay probe     one-shot board state, key=value on stdout
                               (works from a host with no route to the board,
                                which plain haps-board-probe cannot do)

Environment (shared with haps-tunnel where it makes sense):
    HAPS_TUNNEL_SSH          jump host              (default haps-dev)
    HAPS_CONFPRO_RHOST       board as the jump host names it (default haps-sx)
    HAPS_TUNNEL_CTRL         ssh ControlPath to reuse (default ~/.ssh/cm-haps-tunnel)
    HAPS_STATE_LOCAL_IP      address the GUI knows the board by (default 127.0.0.1)
    HAPS_STATE_QUERY_PORT    UDP port we listen on      (default 18009)
    HAPS_STATE_REPLY_PORT    UDP port the GUI listens on(default 18008)
    HAPS_STATE_CACHE         seconds to reuse a reply   (default 2.0)
    HAPS_NO_TUNNEL=1         disable (honoured, same as haps-tunnel)
    HAPS_ON_NET=1            on the bench segment; no relay needed
"""

import base64
import errno
import json
import os
import select
import signal
import socket
import subprocess
import sys
import time

MAGIC = b"*** CA BOARD SEARCHING FEEDBACK ***"
SEARCH_KEY = "Cobra System Search Device"

SSH_TARGET = os.environ.get("HAPS_TUNNEL_SSH", "haps-dev")
BOARD = os.environ.get("HAPS_CONFPRO_RHOST", "haps-sx")
CTRL = os.environ.get("HAPS_TUNNEL_CTRL", os.path.expanduser("~/.ssh/cm-haps-tunnel"))
LOCAL_IP = os.environ.get("HAPS_STATE_LOCAL_IP", "127.0.0.1")


def _num(name, default, cast):
    """Env numbers must never take down a subcommand.

    These are read at import, so an unparseable value would otherwise traceback
    out of `down` and `status` too -- on every shell that loads the module.
    """
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        return cast(raw)
    except (TypeError, ValueError):
        sys.stderr.write("haps-state-relay: ignoring %s=%r (not a number)\n" % (name, raw))
        return default


# The board's own protocol. These are fixed by the vendor firmware -- the query
# goes to 18009 and the board answers to 18008 -- so they are NOT configurable.
# Exposing them as knobs once meant that "18009 is busy locally, I will move it"
# silently retargeted the REMOTE probe at a port the board does not listen on,
# and the only symptom was a grey panel and a log line nobody reads.
BOARD_QUERY_PORT = 18009
BOARD_REPLY_PORT = 18008

# Where WE listen locally, and where the GUI listens. Local concerns only; they
# do not touch the board protocol above.
QUERY_PORT = _num("HAPS_STATE_QUERY_PORT", 18009, int)
REPLY_PORT = _num("HAPS_STATE_REPLY_PORT", 18008, int)
# Clamped: a huge TTL would serve day-old occupancy as if it were current.
CACHE_TTL = max(0.0, min(_num("HAPS_STATE_CACHE", 2.0, float), 30.0))
# A failed probe is cached too, and for longer. Without this a silent board costs
# the remote's full 3 s timeout on EVERY query, and the single-threaded loop
# falls behind the GUI's polling until the socket buffer overflows -- then
# machine-guns the backlog at the GUI when the board comes back.
FAIL_TTL = max(0.0, min(_num("HAPS_STATE_FAIL_CACHE", 15.0, float), 120.0))
# Longer than the remote's own 3 s socket timeout plus a slow ssh round trip, so
# it only ever fires on a genuinely wedged jump host -- never on a silent board,
# which the remote reports as ERR by itself.
READ_TIMEOUT = _num("HAPS_STATE_READ_TIMEOUT", 8.0, float)

RUNDIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
PIDFILE = os.path.join(RUNDIR, ".haps-state-relay.pid.%d" % os.getuid())
LOGFILE = os.path.join(RUNDIR, ".haps-state-relay.log.%d" % os.getuid())

# The remote half. Runs on the jump host, which HAS a route to the board and
# can therefore bind 18008 and speak the real protocol. One long-lived process
# over the multiplexed ssh channel, not a process per query: touchBorad() is
# called on a GUI timer and a per-query ssh would add a connection setup to
# every refresh. Binds 18008 only for the duration of a probe and releases it,
# so a ConfPro running on the jump host itself is not locked out -- and if that
# ConfPro holds the port, the probe reports ERR and the relay stays silent
# rather than guessing.
REMOTE = r'''
import socket, sys, base64
QP, RP = %d, %d
for line in sys.stdin:
    board = line.strip()
    if not board:
        continue
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    # Deliberately NO SO_REUSEADDR: with it, two wildcard binds of 18008 both
    # succeed and the LAST one wins the datagrams -- so a probe would silently
    # steal board replies from a ConfPro running on the jump host itself and
    # leave that GUI flapping. Without it the bind fails, we report ERR, and the
    # relay stays quiet. The exclusion below is the whole point.
    try:
        s.bind(("0.0.0.0", RP))
    except Exception as exc:
        sys.stdout.write("ERR bind-%%d %%s\n" %% (RP, exc)); sys.stdout.flush()
        s.close(); continue
    s.settimeout(3.0)
    try:
        q = '{\n    "%s": "%%s"\n}\n' %% board
        s.sendto(q.encode(), (board, QP))
        d, _ = s.recvfrom(65535)
        sys.stdout.write("OK %%s\n" %% base64.b64encode(d).decode())
    except Exception as exc:
        sys.stdout.write("ERR %%s\n" %% exc)
    finally:
        s.close()
    sys.stdout.flush()
''' % (BOARD_QUERY_PORT, BOARD_REPLY_PORT, SEARCH_KEY)


def loopback_only():
    """Is our listener confined to loopback?

    Bound to 127.0.0.1 the relay is reachable only by this host's own users.
    Bound wider it becomes an unauthenticated x790 UDP reflector aimed at a
    FIXED victim port (18008) -- a query is ~48 bytes, a reply ~793 -- spending
    an ssh credential to the bench on every packet. Widening therefore has to be
    deliberate, not a typo in an env var.
    """
    return LOCAL_IP.startswith("127.") or LOCAL_IP == "::1"


def query_names_us(payload):
    """Accept only a well-formed query for the endpoint WE serve.

    Two jobs. It rejects garbage (any byte at all used to draw a full reply out
    of us), and -- because this relay serves exactly ONE board -- it refuses to
    answer a query about some OTHER board with our board's state. Doing that
    would hand the GUI a reply whose "board id" belongs to a different system,
    which it would happily file against the wrong row.
    """
    try:
        obj = json.loads(payload.decode("utf-8", "replace"))
    except ValueError:
        return False
    if not isinstance(obj, dict):
        return False
    return str(obj.get(SEARCH_KEY, "")) == LOCAL_IP


def log(msg):
    sys.stderr.write("haps-state-relay: %s\n" % msg)
    sys.stderr.flush()


class Helper(object):
    """The remote probe process, restarted on demand.

    Never raises: every failure path leaves .proc None and returns no data, so
    a dead jump host degrades the relay to silence instead of taking it down.
    """

    def __init__(self):
        self.proc = None

    def _spawn(self):
        payload = base64.b64encode(REMOTE.encode()).decode()
        # base64 so the remote script crosses ssh's shell with no quoting
        # hazard, and stdin stays free to carry the query protocol.
        remote_cmd = (
            "python3 -u -c \"import base64;exec(base64.b64decode('%s'))\"" % payload
        )
        argv = [
            "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
            "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=3",
        ]
        # Reuse the ControlMaster haps-tunnel already opened when it is there;
        # ssh falls back to its own connection when it is not.
        if CTRL:
            argv += ["-o", "ControlPath=%s" % CTRL]
        argv += [SSH_TARGET, remote_cmd]
        try:
            self.proc = subprocess.Popen(
                argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
        except Exception as exc:
            log("could not start helper on %s (%s)" % (SSH_TARGET, exc))
            self.proc = None

    def probe(self, board):
        """Return the raw reply datagram, or None."""
        for attempt in (0, 1):
            if self.proc is None or self.proc.poll() is not None:
                if attempt:
                    return None
                self._spawn()
                if self.proc is None:
                    return None
            try:
                self.proc.stdin.write((board + "\n").encode())
                self.proc.stdin.flush()
                # NEVER a bare readline(): serve() is single-threaded, and an ssh
                # that connects and then wedges (dead peer, suspended host) would
                # otherwise block every future refresh for as long as it hangs.
                ready, _, _ = select.select([self.proc.stdout], [], [], READ_TIMEOUT)
                if not ready:
                    log("helper timed out after %.0fs - restarting it" % READ_TIMEOUT)
                    self.kill()
                    continue
                line = self.proc.stdout.readline()
            except Exception:
                self.kill()
                continue
            if not line:
                # Helper died (jump host dropped, key expired). Retry once.
                self.kill()
                continue
            line = line.decode("utf-8", "replace").strip()
            if line.startswith("OK "):
                try:
                    return base64.b64decode(line[3:])
                except Exception:
                    return None
            if line.startswith("ERR "):
                log("probe failed: %s" % line[4:])
                return None
            return None
        return None

    def kill(self):
        """Stop the helper, remote end included.

        Closing stdin first gives the remote loop a clean EOF so it exits on
        its own; the signals are the fallback. A leaked remote helper WAS
        observed on the jump host before this existed (the one-shot `probe`
        path orphaned its ssh outright), though a bare kill of a multiplexed
        slave does also reap the remote in testing -- so treat the graceful
        step as belt-and-braces rather than the sole guarantee.

        The stdin wait deliberately exceeds the remote's own 3 s socket
        timeout: a shorter one always loses the race mid-probe and escalates
        to signals for no reason.
        """
        proc, self.proc = self.proc, None
        if proc is None:
            return
        # Per-step budgets. The EOF step must outlast the remote's own 3 s
        # socket timeout or it always loses the race mid-probe; the signal steps
        # must be SHORT, because cmd_down waits on this and a slow teardown is
        # what lets a following `up` find the port still held.
        for step, grace in (("stdin", 3.5), ("terminate", 1.0), ("kill", 1.0)):
            try:
                if step == "stdin":
                    if proc.stdin:
                        proc.stdin.close()
                elif step == "terminate":
                    proc.terminate()
                else:
                    proc.kill()
            except Exception:
                pass
            try:
                proc.wait(timeout=grace)
                break
            except Exception:
                continue
        for stream in (proc.stdout, proc.stdin):
            try:
                if stream:
                    stream.close()
            except Exception:
                pass


def rewrite(raw):
    """Re-address the board's reply to the endpoint the GUI knows.

    Returns bytes ready to send, or None if the payload is not what we expect
    -- in which case we stay silent rather than feed the GUI something odd.
    The board emits Qt's QJsonDocument::toJson(Indented): 4-space indent, keys
    sorted, trailing newline. json.dumps(sort_keys=True, indent=4) + "\n"
    reproduces it byte for byte, so the GUI sees the shape it expects.
    """
    body = raw[len(MAGIC):] if raw.startswith(MAGIC) else raw
    try:
        info = json.loads(body.decode("utf-8", "replace"))
    except ValueError:
        return None
    if not isinstance(info, dict) or "board id" not in info:
        return None
    info["active ip"] = LOCAL_IP
    if "host ip list" in info:
        info["host ip list"] = [{"host ip": LOCAL_IP}]
    return MAGIC + (json.dumps(info, sort_keys=True, indent=4,
                           ensure_ascii=False) + "\n").encode("utf-8")


def serve():
    """Foreground relay loop."""
    if not loopback_only() and os.environ.get("HAPS_STATE_ALLOW_REMOTE") != "1":
        log("refusing to bind non-loopback %s (set HAPS_STATE_ALLOW_REMOTE=1 if "
            "you really mean it)" % LOCAL_IP)
        return 1

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    # Deliberately NO SO_REUSEADDR: the bind IS the single-daemon mutex, and it
    # is what port_taken() detects. Adding it would silently break both.
    try:
        sock.bind((LOCAL_IP, QUERY_PORT))
    except OSError as exc:
        if exc.errno == errno.EADDRINUSE:
            # Another relay owns the port, so `up` is idempotent. Say so: a
            # silent exit here is what makes a lost-relay race undiagnosable.
            log("%s:%d already held - not starting a second relay"
                % (LOCAL_IP, QUERY_PORT))
            return 0
        log("cannot bind %s:%d (%s)" % (LOCAL_IP, QUERY_PORT, exc))
        return 1

    helper = Helper()
    cached_at, cached = 0.0, None
    warned_foreign = False

    def bye(_signum, _frame):
        helper.kill()
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    log("up: %s:%d -> %s:%s (replies to %s:%d)"
        % (LOCAL_IP, QUERY_PORT, SSH_TARGET, BOARD, LOCAL_IP, REPLY_PORT))

    while True:
        try:
            query, peer = sock.recvfrom(65535)
        except OSError:
            # No backoff loop: a persistently erroring socket would otherwise
            # spin a core on a shared login node.
            time.sleep(0.05)
            continue

        if not (peer[0].startswith("127.") or peer[0] == "::1"):
            if not warned_foreign:
                log("ignoring queries from off-host (%s)" % peer[0])
                warned_foreign = True
            continue
        if not query_names_us(query):
            continue

        # Coalesce: while a probe was in flight the GUI may have queued several
        # more. Answering each in turn would put us permanently behind, so drain
        # and serve the newest.
        while True:
            try:
                sock.setblocking(False)
                extra, xpeer = sock.recvfrom(65535)
            except (OSError, socket.error):
                break
            finally:
                sock.setblocking(True)
            if xpeer[0].startswith("127.") and query_names_us(extra):
                peer = xpeer

        # monotonic, not wall clock: an NTP step backwards would otherwise pin a
        # stale reply -- and a stale reply is exactly how a held board comes to
        # look free.
        now = time.monotonic()
        ttl = CACHE_TTL if cached is not None else FAIL_TTL
        if (now - cached_at) >= ttl:
            raw = helper.probe(BOARD)
            cached = rewrite(raw) if raw else None
            cached_at = now
        if cached is None:
            continue
        try:
            # NOTE: sent from this socket, so the source is LOCAL_IP:QUERY_PORT
            # -- what a real board's reply looks like. Never bind REPLY_PORT:
            # the GUI holds it exclusively while its dialog is open, and it does
            # not check the reply's source anyway.
            sock.sendto(cached, (peer[0], REPLY_PORT))
        except OSError as exc:
            log("could not deliver reply (%s)" % exc)


def running_pid():
    try:
        with open(PIDFILE) as fh:
            pid = int(fh.read().strip())
    except (IOError, OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    # os.kill(pid, 0) only proves SOMETHING owns that pid. PIDs are recycled, and
    # a stale pidfile whose number has been reissued would otherwise make `down`
    # signal an unrelated process. Confirm it is actually ours before believing it.
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            argv = fh.read().decode("utf-8", "replace")
    except (IOError, OSError):
        return None
    if "haps-state-relay" not in argv:
        return None
    return pid


def port_taken():
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.bind((LOCAL_IP, QUERY_PORT))
    except OSError:
        return True
    finally:
        probe.close()
    return False


def cmd_up():
    # Retry the gate: a relay that is still shutting down (see cmd_down) would
    # otherwise make us decline to start and leave nothing running.
    deadline = time.monotonic() + 3.0
    while True:
        if running_pid():
            return 0
        if not port_taken():
            break
        if time.monotonic() >= deadline:
            # Held by something that is not ours and is not going away. On a
            # shared host that is very likely another user's relay, which will
            # serve this GUI too -- until THEY unload. Say so; do not fail.
            log("%s:%d is held by another process (another user's relay?) - "
                "not starting one; board state will come from theirs"
                % (LOCAL_IP, QUERY_PORT))
            return 0
        time.sleep(0.1)
    try:
        with open(LOGFILE, "ab") as logfh:
            proc = subprocess.Popen(
                [sys.executable, os.path.abspath(__file__), "run"],
                stdin=subprocess.DEVNULL, stdout=logfh, stderr=logfh,
                start_new_session=True,
            )
        # Inside the guard: RUNDIR is /tmp when XDG_RUNTIME_DIR is unset, so a
        # co-tenant-owned file at this path must not traceback on every shell.
        with open(PIDFILE, "w") as fh:
            fh.write("%d\n" % proc.pid)
    except Exception as exc:
        log("WARN could not start relay (%s) - board state will be unavailable" % exc)
        return 0
    # Give it long enough to bind and report, but never long enough to be felt
    # as a hang in `module load`.
    time.sleep(0.4)
    if proc.poll() is not None:
        log("WARN relay exited immediately - see %s" % LOGFILE)
    return 0


def cmd_down():
    """Stop the relay AND wait for the port to come free.

    Returning as soon as SIGTERM is sent is not enough. The daemon can hold
    18009 for a couple of seconds while it winds up an in-flight probe, and
    `module switch haps-dev haps-identify` runs `down` then `up` back to back:
    the new `up` would find the port still taken, decline to start, and then the
    old daemon exits -- leaving NO relay at all, silently. Reproduced 3/3 with a
    probe in flight before this wait existed.
    """
    pid = running_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.monotonic() + 5.0
    while time.monotonic() < deadline:
        if not port_taken() and running_pid() is None:
            break
        time.sleep(0.1)
    try:
        os.unlink(PIDFILE)
    except OSError:
        pass
    return 0


def cmd_status():
    pid = running_pid()
    if pid:
        print("up (pid %d): %s:%d -> %s:%s" % (pid, LOCAL_IP, QUERY_PORT, SSH_TARGET, BOARD))
    elif port_taken():
        print("up (not ours): something already holds %s:%d" % (LOCAL_IP, QUERY_PORT))
    else:
        print("down")
    return 0


def cmd_probe(argv):
    """One-shot state query, in haps-board-probe's key=value shape."""
    board = argv[0] if argv else BOARD
    helper = Helper()
    try:
        raw = helper.probe(board)
    finally:
        # Without this the ssh child outlives this process and the remote
        # python3 with it -- a leak per invocation.
        helper.kill()
    if not raw:
        print("reachable=no"); print("state=unknown"); print("holder=")
        print("name="); print("clientcode=")
        return 0
    body = raw[len(MAGIC):] if raw.startswith(MAGIC) else raw
    try:
        info = json.loads(body.decode("utf-8", "replace"))
    except ValueError:
        print("reachable=yes"); print("state=unknown"); print("holder=")
        print("name="); print("clientcode=")
        return 0
    # "control"/"controller" is the ConfPro session pair, but it is NOT the only
    # way this board is occupied: there is a separate XVC route (see the
    # haps-xvc entry in ~/.ssh/config, LocalForward 2542) whose holder shows up
    # in "xvc is control"/"xvc controler", and a third pair in "board is
    # control"/"board controler". Reading only the first pair reports a board
    # somebody is actively debugging on as idle -- and this tool's whole job is
    # to answer "is it free?" on a shared rig. Any of them counts as busy.
    def _pair(flag, who):
        held = bool(info.get(flag, False))
        name = str(info.get(who, "") or "").replace("::ffff:", "")
        if name.lower() in ("idle", "none"):
            name = ""
        return held or name != "", name

    confpro, confpro_who = _pair("control", "controller")
    boardc, board_who = _pair("board is control", "board controler")
    xvc, xvc_who = _pair("xvc is control", "xvc controler")
    in_use = confpro or boardc or xvc
    holder = confpro_who or board_who or xvc_who
    print("reachable=yes")
    print("state=%s" % ("used" if in_use else "idle"))
    print("holder=%s" % holder)
    print("held_by_confpro=%s" % ("yes" if confpro else "no"))
    print("held_by_xvc=%s" % ("yes" if xvc else "no"))
    print("name=%s" % info.get("board name", ""))
    print("clientcode=%s" % info.get("client code", ""))
    return 0


def main():
    argv = sys.argv[1:]
    action = argv[0] if argv else ""
    # Honoured for every subcommand, not just `up`: "disabled" must also mean
    # `probe` does not quietly reach out over ssh.
    if action in ("up", "probe", "run"):
        if os.environ.get("HAPS_NO_TUNNEL") == "1":
            log("disabled (HAPS_NO_TUNNEL=1)")
            return 0
        if os.environ.get("HAPS_ON_NET") == "1" and action != "probe":
            log("on the bench segment (HAPS_ON_NET=1); UDP reaches the board directly")
            return 0
    if action == "up":
        return cmd_up()
    if action == "down":
        return cmd_down()
    if action == "status":
        return cmd_status()
    if action == "probe":
        return cmd_probe(argv[1:])
    if action == "run":
        return serve()
    sys.stderr.write("usage: %s {up|down|status|probe [board]}\n" % sys.argv[0])
    return 2


if __name__ == "__main__":
    sys.exit(main())
