#%Module1.0
##
## haps-identify/1.0 -- SoC-Labs HAPS-SX Vivado + Synopsys IICE-debug bundle
##
proc ModulesHelp { } {
    puts stderr "SoC-Labs HAPS-SX Vivado + Synopsys IICE-debug bundle."
    puts stderr ""
    puts stderr "Everything in haps-dev PLUS the Synplify/Identify FSDB debug route:"
    puts stderr "  vivado       site default (2026.1)"
    puts stderr "  confpro_sx   board programming (confpro-program)"
    puts stderr "  synplify     Synopsys front end (Premier DP)"
    puts stderr "  identify     IICE instrumentation debugger (device jtagport builtin -> VU19P BSCAN)"
    puts stderr "  verdi        FSDB viewer (write fsdb / launch_verdi)"
    puts stderr "  haps-tunnel  localhost:3121 hw_server + :18000 ConfPro via haps-dev"
    puts stderr ""
    puts stderr "Everyday Vivado-only flow:  module load haps-dev"
    puts stderr "Legacy ProtoCompiler flow:  module load haps-sx-tools"
}
module-whatis "SoC-Labs HAPS-SX Vivado + Synopsys IICE debug bundle (vivado + confpro_sx + synplify + identify + verdi + tunnel)"

conflict haps-identify
conflict haps-sx-tools
conflict haps-dev

# UNGUARDED loads => refcounted auto-unload + tunnel teardown on unload (Modules 4.5.2).
module load vivado                 ;# site default (2026.1)
module load confpro_sx
module load synplify               ;# Synopsys front end
module load identify               ;# IICE instrumentation debugger
module load verdi                  ;# FSDB viewer (explicit -- protocompiler used to pull it)
module load haps-tunnel

set install_root /apps/synopsys/haps/haps-sx
if { [module-info mode load] && ![file isdirectory $install_root] } {
    puts stderr "haps-identify: WARNING install root not found: $install_root"
}
setenv HAPS_SX_TOOLS_ROOT $install_root
setenv COBRA_PATH         $install_root/haps-sx_helper
