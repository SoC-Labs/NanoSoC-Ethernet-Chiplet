[submodule "tidechart"]
	path = tidechart
	url = https://git.soton.ac.uk/soclabs/tidechart.git
[submodule "tidelink"]
	path = tidelink
	url = git@github.com:SoC-Labs/TideLink-Chiplet-Interconnect-AHB.git
[submodule "nanosoc-multicore-system"]
	path = nanosoc-multicore-system
	url = https://git.soton.ac.uk/soclabs/nanosoc-multicore-system.git
[submodule "ASIC/asic-flows"]
	path = ASIC/asic-flows
	url = https://github.com/SoC-Labs/ASIC-Flow.git
	branch = lpddr4-pll
[submodule "ASIC/asic-toolkit"]
	path = ASIC/asic-toolkit
	url = git@github.com:SoC-Labs/nanoSoC-ASIC-Toolkit.git
	# The pin lives on this branch, NOT on main: main lacks flow/power/ entirely
	# and 21 further engine commits. Declaring main here made
	# `git submodule update --remote` a silent 21-commit downgrade of the flow
	# engine. Change this back to main only when the branch is merged.
	branch = fix/tcl-parse-gate-both-directions
